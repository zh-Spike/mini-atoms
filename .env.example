DATABASE_URL=sqlite:///./mini_atoms.db

# Any OpenAI-compatible endpoint (DeepSeek, Qwen/DashScope, OpenRouter, ...)
LLM_BASE_URL=https://cf.api.fan/v1
# Leave empty to run in demo mode: agents replay prebuilt apps, no model needed
LLM_API_KEY=
LLM_MODEL=deepseek-flash
# Set to false for providers that reject the DeepSeek-style `thinking` parameter
LLM_DISABLE_THINKING=true
# Race mode: models (same gateway) users can pick 2-3 of; LLM_MODEL is always offered too
LLM_RACE_MODELS=glm-5.3-flashx,glm-5.3,grok-4.7
# Models called via the Responses API (others switch automatically on protocol_not_supported)
LLM_RESPONSES_MODELS=glm-5.3,grok-4.7
# Output cap per model call (reasoning + answer); 0 = provider default
LLM_MAX_TOKENS=16384
# Force demo mode even with a key (e.g. to rehearse a demo without spending quota)
LLM_MOCK=false

# Signs the guest session cookie; use a long random string in production
SECRET_KEY=dev-secret-change-me
# Comma-separated CODE:max_uses pairs; codes removed from this list are disabled on restart
INVITE_CODES=DEMO:100
USER_GENERATION_LIMIT=30
# Comma-separated usernames that can open /admin (operations dashboard, full prompt traces)
ADMIN_USERNAMES=
