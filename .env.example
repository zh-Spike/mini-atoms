DATABASE_URL=sqlite:///./mini_atoms.db

# Any OpenAI-compatible endpoint (DeepSeek, Qwen/DashScope, OpenRouter, ...)
LLM_BASE_URL=https://cf.api.fan/v1
LLM_API_KEY=
LLM_MODEL=deepseek-flash
# Set to false for providers that reject the DeepSeek-style `thinking` parameter
LLM_DISABLE_THINKING=true

# Signs the guest session cookie; use a long random string in production
SECRET_KEY=dev-secret-change-me
# Comma-separated CODE:max_uses pairs; codes removed from this list are disabled on restart
INVITE_CODES=DEMO:100
GUEST_GENERATION_LIMIT=30
